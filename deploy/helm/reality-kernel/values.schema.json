{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["image", "profiles", "failurePolicy", "k8sCgroupRoot", "nri"],
  "properties": {
    "image": {
      "type": "object",
      "required": ["repository"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "tag": {"type": "string"},
        "pullPolicy": {"enum": ["Always", "IfNotPresent", "Never"]}
      }
    },
    "profiles": {"type": "string"},
    "namespaces": {
      "type": "object",
      "propertyNames": {"pattern": "^[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?$"},
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "default": {"type": "string"},
          "allowed": {"type": "array", "items": {"type": "string"}, "minItems": 1}
        },
        "anyOf": [{"required": ["default"]}, {"required": ["allowed"]}]
      }
    },
    "extraPolicy": {"type": "string"},
    "failurePolicy": {"enum": ["Fail", "Ignore"]},
    "heartbeatTimeoutSeconds": {"type": "integer", "minimum": 1},
    "k8sCgroupRoot": {"type": "string", "minLength": 1},
    "nri": {
      "type": "object",
      "required": ["socket", "pluginIndex"],
      "properties": {
        "socket": {"type": "string"},
        "pluginIndex": {"type": "string", "pattern": "^[0-9]{2}$"}
      }
    },
    "logLevel": {"type": "string"}
  }
}
