# Reality Kernel - Local Development Environment Variables
# Copy this file to .env for local testing

# Supabase (Optional: only needed if testing the remote telemetry/cloud sync)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-key-here

# API Configuration
PORT=8000
ENVIRONMENT=development

# Reality Kernel Attestation (Ed25519)
RK_SIGNING_KEY=
RK_API_KEY=rk_test_sample_key_12345
